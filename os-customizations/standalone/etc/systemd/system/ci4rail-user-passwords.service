[Unit]
Description=Apply user password hashes from os-customization
DefaultDependencies=no
After=local-fs.target
Before=sysinit.target dropbear.socket
ConditionDirectoryNotEmpty=/etc/ci4rail/user-passwords

[Service]
Type=oneshot
RemainAfterExit=yes
# Each file /etc/ci4rail/user-passwords/<user> holds the crypt hash for <user>.
# chpasswd only runs when the hash differs, e.g. after a factory reset.
ExecStart=/bin/sh -c 'for f in /etc/ci4rail/user-passwords/*; do u=$${f##*/}; h=$$(cat "$$f"); cur=$$(grep "^$$u:" /etc/shadow | cut -d: -f2); [ "$$h" = "$$cur" ] || echo "$$u:$$h" | chpasswd -e; done'

[Install]
WantedBy=sysinit.target
