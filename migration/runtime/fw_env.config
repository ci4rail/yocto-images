# CPU01 and CPU01plus Mender U-Boot environment: two 8 KiB copies in boot0.
# Matches meta-mender-toradex-nxp/recipes-bsp/u-boot/u-boot-toradex_%.bbappend.
# Negative offsets are measured from the end; the final 512 bytes hold the
# Toradex configuration block. TEZI supplies the stable eMMC boot0 alias.
/dev/emmc-boot0 -0x2200 0x2000
/dev/emmc-boot0 -0x4200 0x2000
