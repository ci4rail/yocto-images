--- /dev/null
+++ b/common/testfarm-recovery.c
@@ -0,0 +1,44 @@
+// SPDX-License-Identifier: GPL-2.0+
+/* USB-only, RAM-resident testfarm recovery. No fuse or eMMC writes here. */
+#include <common.h>
+#include <command.h>
+#include <console.h>
+#include <env.h>
+#include <linux/libfdt.h>
+
+#define RECOVERY_ADDR 0x60000000UL
+#define RECOVERY_MAX_SIZE 0x10000000UL
+#ifdef CONFIG_TARGET_VERDIN_IMX8MP
+#define RECOVERY_CONSOLE "console=ttymxc2,115200 "
+#else
+#define RECOVERY_CONSOLE "console=ttymxc0,115200 "
+#endif
+
+void testfarm_recovery(void)
+{
+	const void *fit = (const void *)RECOVERY_ADDR;
+	ulong size;
+
+	/* Do not inherit bootcmd, bootargs or Fastboot overrides from eMMC. */
+	env_set_default(NULL, 0);
+	disable_ctrlc(1);
+	env_set("filesize", NULL);
+	puts("TESTFARM-RECOVERY: waiting for signed FIT over USB\n");
+	if (run_command("fastboot usb 0", 0))
+		panic("Testfarm recovery: USB transfer failed\n");
+	size = env_get_hex("filesize", 0);
+	if (size < sizeof(struct fdt_header) || size > RECOVERY_MAX_SIZE ||
+	    fdt_check_header(fit) || fdt_totalsize(fit) > size)
+		panic("Testfarm recovery: invalid FIT size/header\n");
+	if (env_set("bootargs", RECOVERY_CONSOLE
+		    "root=/dev/ram0 rootfstype=squashfs ro ramdisk_size=393216") ||
+	    env_set("bootm_low", "0x40000000") ||
+	    env_set("bootm_size", "0x58000000") ||
+	    env_set("bootm_mapsize", NULL) || env_set("fdt_high", NULL) ||
+	    env_set("initrd_high", NULL) || env_set("silent_linux", "no") ||
+	    env_set("verify", "yes") || env_set("autostart", "yes"))
+		panic("Testfarm recovery: cannot set boot parameters\n");
+	/* Toradex bootm protection and required FIT configuration key remain active. */
+	run_command("bootm 0x60000000#recovery", 0);
+	panic("Testfarm recovery: authenticated boot failed\n");
+}
